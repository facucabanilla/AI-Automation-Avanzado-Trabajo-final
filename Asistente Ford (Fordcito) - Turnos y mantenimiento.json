    {
      "parameters": {
        "jsCode": "// 1. Apuntamos al nodo y propiedad del subflujo\nconst texto = $(\"Opciones disponibles\").first().json.data[\"Opción elegida\"] || \"\"; \n\n// 2. REGEX HÍBRIDA: Detecta tanto \"De 08:00 AM a 10:00 AM\" como \"08:00 AM - 10:00 AM\"\nconst m = texto.match(\n  /(\\d{2})\\/(\\d{2})\\/(\\d{4})\\s*\\|\\s*(?:[Dd]e\\s*)?(\\d{1,2}):(\\d{2})\\s*([APap][Mm])\\s*(?:a|-)\\s*(\\d{1,2}):(\\d{2})\\s*([APap][Mm])/\n);\n\nif (!m) {\n  throw new Error(\"No pude interpretar el formato del turno en el texto: \" + texto);\n}\n\n// 3. Desestructuración de variables\nconst [, dd, mm, yyyy, h1, min1, ap1, h2, min2, ap2] = m;\n\n// 4. Conversor limpio a 24 horas\nconst to24 = (h, ap) => {\n  let hrs = parseInt(h, 10);\n  const isPM = ap.toUpperCase() === 'PM';\n  \n  if (isPM && hrs !== 12) hrs += 12;\n  if (!isPM && hrs === 12) hrs = 0;\n  \n  return String(hrs).padStart(2, '0');\n};\n\n// 5. Retorno estructurado con formato ISO nativo para Google Calendar\nreturn [{\n  json: {\n    start: `${yyyy}-${mm}-${dd}T${to24(h1, ap1)}:${min1}:00-03:00`,\n    end:   `${yyyy}-${mm}-${dd}T${to24(h2, ap2)}:${min2}:00-03:00`,\n    turno_confirmado: \"Día \" + dd + \"/\" + mm + \"/\" + yyyy + \" de \" + h1 + \":\" + min1 + \" \" + ap1.toUpperCase() + \" a \" + h2 + \":\" + min2 + \" \" + ap2.toUpperCase()\n  }\n}];\n\n\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
